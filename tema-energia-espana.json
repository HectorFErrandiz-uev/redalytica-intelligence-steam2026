{
  "name": "Energia España - Premios STEAM 2026",
  "description": "Tema profesional para dashboard de transición energética. Paleta sobria con identidad técnica.",
  "dataColors": [
    "#1E5288",
    "#3CB371",
    "#E76F51",
    "#7C7DAD",
    "#F4C430",
    "#7FCDCD",
    "#A8D5BA",
    "#8B4513",
    "#8D99AE",
    "#2B2D42"
  ],
  "background": "#FFFFFF",
  "foreground": "#2B2D42",
  "tableAccent": "#1E5288",
  "good": "#3CB371",
  "neutral": "#F4C430",
  "bad": "#E76F51",
  "maximum": "#1E5288",
  "center": "#8D99AE",
  "minimum": "#E76F51",
  "null": "#F4F4F6",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 36,
      "color": "#1E5288"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#2B2D42"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#2B2D42"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#2B2D42"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 14,
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E5288"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E5288"
              }
            },
            "radius": 6
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 36,
            "bold": true
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "lineStyle": "solid",
            "shadeArea": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#2B2D42"
              }
            }
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ]
      }
    },
    "stackedAreaChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#1E5288"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "treemap": {
      "*": {
        "dataLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "rowPadding": 6,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E5288"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "bold": true,
            "alignment": "left"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F4F4F6"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E5288"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "bold": true
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E5288"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "bold": true
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1E5288"
              }
            },
            "background": {
              "solid": {
                "color": "#F4F4F6"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#2B2D42"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": false,
            "show": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
